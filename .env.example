# Copy to .env.local (LiveKit CLI: `lk app env -w`) or .env, then fill in.
# Never commit the filled file.

# LiveKit Cloud (or self-hosted LiveKit server)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Developer API — Gemini Live speech-to-speech (default path)
# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Do not set GOOGLE_APPLICATION_CREDENTIALS for the default stack.
# That path is Google Cloud STT/TTS (service account), which this agent
# does not use.
